{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "$env{FSX_VCPKG_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{FSX_VCPKG_HOST_TRIPLET}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "BUILD_TESTING": "OFF",
        "FSX_ENABLE_ASAN": "OFF",
        "FSX_ENABLE_UBSAN": "OFF",
        "FSX_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "FSX_VCPKG_TARGET_TRIPLET": "qigao-x64-windows-llvm-mingw",
        "FSX_VCPKG_HOST_TRIPLET": "qigao-x64-windows-llvm-mingw",
        "PKG_CONFIG": "$penv{PKG_CONFIG}",
        "QIGAO_PKGCONF_VERSION": "$penv{QIGAO_PKGCONF_VERSION}",
        "VCPKG_KEEP_ENV_VARS": "$penv{VCPKG_KEEP_ENV_VARS};PKG_CONFIG;QIGAO_PKGCONF_VERSION",
        "PATH": "${sourceDir}/build/${presetName}/bin;$env{SALTSCORE_ROOT}/bin;$env{CMETA_ROOT}/bin;${sourceDir}/build/${presetName}/vcpkg_installed/$env{FSX_VCPKG_TARGET_TRIPLET}/debug/bin;${sourceDir}/build/${presetName}/vcpkg_installed/$env{FSX_VCPKG_TARGET_TRIPLET}/bin;$penv{PATH}"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      },
      "environment": {
        "FSX_VCPKG_TARGET_TRIPLET": "x64-linux",
        "FSX_VCPKG_HOST_TRIPLET": "x64-linux",
        "LD_LIBRARY_PATH": "${sourceDir}/build/${presetName}/lib:$env{SALTSCORE_ROOT}/lib:$env{CMETA_ROOT}/lib:$penv{LD_LIBRARY_PATH}"
      }
    }
  ]
}
