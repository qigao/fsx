# Optional local settings. CMake does not automatically load .env.
# Use absolute, forward-slash paths. Do not expand $VAR or ${VAR} in dotenv.
# Keep the actual .env private; preserve the shared binary-cache policy in CI.
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
VCPKG_ROOT=C:/path/to/canonical/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache
VCPKG_BINARY_SOURCES=clear;default,readwrite
CMAKE_BUILD_PARALLEL_LEVEL=2

# Compatible split SDKs and a native host re2c package.
SALTSCORE_ROOT=C:/sdk/saltscore/windows-x64
CMETA_ROOT=C:/sdk/cmeta/windows-x64
RE2C_ROOT=C:/tools/re2c

# Outputs of the shared Windows LLVM-MinGW compiler setup.
LLVM_MINGW_TOOLCHAIN_FILE=C:/tools/llvm-mingw/qigao-product-toolchain.cmake
LLVM_MINGW_DEPENDENCY_TOOLCHAIN_FILE=C:/tools/llvm-mingw/qigao-toolchain.cmake
LLVM_MINGW_HOST_DEPENDENCY_TOOLCHAIN_FILE=C:/tools/llvm-mingw/qigao-host-toolchain.cmake

# The shared native pkgconf setup supplies PKG_CONFIG/QIGAO_PKGCONF_VERSION.
# Cache checkout must contain the pinned LLVM-MinGW triplets and helper.
# GITHUB_TOKEN is provided privately by the calling environment when needed.
