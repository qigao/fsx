if(FSX_ENABLE_TSAN AND
   (FSX_ENABLE_ASAN OR FSX_ENABLE_UBSAN))
  message(FATAL_ERROR "ThreadSanitizer cannot be combined with ASan/UBSan")
endif()

if(FSX_ENABLE_ASAN OR FSX_ENABLE_UBSAN OR FSX_ENABLE_TSAN)
  if(NOT CMAKE_C_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "FileSearch sanitizer profiles require Clang/LLVM")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    message(FATAL_ERROR "FileSearch sanitizer profiles require Linux or macOS")
  endif()
  if(FSX_ENABLE_TSAN AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "FileSearch ThreadSanitizer profiles require Linux")
  endif()

  set(_saltscore_sanitizers)
  if(FSX_ENABLE_ASAN)
    list(APPEND _saltscore_sanitizers address)
  endif()
  if(FSX_ENABLE_UBSAN)
    list(APPEND _saltscore_sanitizers undefined)
  endif()
  if(FSX_ENABLE_TSAN)
    list(APPEND _saltscore_sanitizers thread)
  endif()
  list(JOIN _saltscore_sanitizers "," _saltscore_sanitizer_list)
  add_compile_options(
    "-fsanitize=${_saltscore_sanitizer_list}"
    -fno-omit-frame-pointer)
  add_link_options("-fsanitize=${_saltscore_sanitizer_list}")
endif()
