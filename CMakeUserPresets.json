{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "environment": {
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "VCPKG_OVERLAY_TRIPLETS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/triplets"
      }
    },
    {
      "name": "sdk-roots",
      "hidden": true,
      "environment": {
        "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
        "CMETA_ROOT": "$penv{CMETA_ROOT}",
        "RE2C_ROOT": "$penv{RE2C_ROOT}"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "inherits": [
        "windows-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "inherits": [
        "windows-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-native-release",
      "displayName": "Windows NTFS live acceptance (Release)",
      "inherits": "windows-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "FSX_BUILD_NTFS_LIVE_TESTS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug",
      "inherits": [
        "linux-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release",
      "inherits": [
        "linux-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-content-release",
      "displayName": "Linux optimized content measurements",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "FSX_BUILD_CONTENT_TESTS": "ON",
        "FSX_BUILD_SEARCH_TOOLS": "ON",
        "FSX_CONTENT_TEST_UGREP": "${sourceDir}/build/${presetName}/vcpkg_installed/x64-linux/tools/ugrep/ugrep",
        "FSX_CONTENT_TEST_BFS": "${sourceDir}/build/${presetName}/vcpkg_installed/x64-linux/tools/bfs/bfs"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "inherits": "linux-debug",
      "cacheVariables": {
        "FSX_ENABLE_ASAN": "ON",
        "FSX_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-debug",
      "cacheVariables": {
        "FSX_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS ARM64 Debug",
      "inherits": [
        "macos-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS ARM64 Release",
      "inherits": [
        "macos-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-x64-debug",
      "displayName": "macOS x64 Debug",
      "inherits": [
        "macos-x64-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS x64 Release",
      "inherits": [
        "macos-x64-base",
        "vcpkg-cache",
        "sdk-roots"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-x64-asan-ubsan",
      "displayName": "macOS x64 ASan/UBSan",
      "inherits": "macos-x64-debug",
      "cacheVariables": {
        "FSX_ENABLE_ASAN": "ON",
        "FSX_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "jobs": 2
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 2
    },
    {
      "name": "windows-native-release",
      "configurePreset": "windows-native-release",
      "jobs": 2
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "jobs": 2
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 2
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "jobs": 2
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "jobs": 2
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "jobs": 2
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 2
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "jobs": 2
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "jobs": 2
    },
    {
      "name": "macos-x64-asan-ubsan",
      "configurePreset": "macos-x64-asan-ubsan",
      "jobs": 2
    },
    {
      "name": "linux-content-release",
      "configurePreset": "linux-content-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-native-regression",
      "configurePreset": "windows-native-release",
      "filter": {
        "exclude": {
          "name": "^fsx_ntfs_(live|link)_test$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "PATH": "${sourceDir}/build/windows-native-release/bin;$env{SALTSCORE_ROOT}/bin;$env{CMETA_ROOT}/bin;${sourceDir}/build/windows-native-release/vcpkg_installed/$env{FSX_VCPKG_TARGET_TRIPLET}/debug/bin;${sourceDir}/build/windows-native-release/vcpkg_installed/$env{FSX_VCPKG_TARGET_TRIPLET}/bin;$penv{PATH}"
      }
    },
    {
      "name": "windows-native-release",
      "configurePreset": "windows-native-release",
      "filter": {
        "include": {
          "name": "^fsx_ntfs_live_test$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-x64-asan-ubsan",
      "configurePreset": "macos-x64-asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-content-release",
      "configurePreset": "linux-content-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
